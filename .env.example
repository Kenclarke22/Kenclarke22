# Execution tool (your order router at localhost:3000)
EXECUTION_BASE_URL=http://localhost:3000
EXECUTION_API_KEY=

# Trading mode
TRADING_MODE=live

# Master agent cycle interval (seconds)
AGENT_CYCLE_SECONDS=60

# Risk limits (live trading guardrails)
MAX_ORDER_NOTIONAL_USD=5000
MAX_POSITION_NOTIONAL_USD=25000
MAX_DAILY_ORDERS=20
MAX_OPEN_POSITIONS=10
ALLOWED_SYMBOLS=

# Optional: comma-separated strategy names to run (empty = all registered)
ACTIVE_STRATEGIES=
